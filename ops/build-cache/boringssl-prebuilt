#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: $0 <boring-sys|btls-sys> <project-dir> [feature-key] [seed-out-dir]" >&2
    exit 2
}

NATIVE_CRATE=${1:-}
PROJECT=${2:-}
FEATURE_KEY=${3:-default}
SEED_OUT=${4:-}

case "$NATIVE_CRATE" in
    boring-sys|btls-sys) ;;
    *) usage ;;
esac
[[ -n "$PROJECT" && -f "$PROJECT/Cargo.lock" ]] || usage
[[ "$FEATURE_KEY" =~ ^[A-Za-z0-9_,.+-]+$ ]] || {
    echo "boringssl-prebuilt: unsupported feature key: $FEATURE_KEY" >&2
    exit 2
}

CACHE_ROOT=${BORING_BSSL_CACHE_ROOT:-${SENTINELX_BORINGSSL_CACHE_ROOT:-/srv/scratch/toolchains/boringssl-prebuilt}}
BUILD_ROOT=${SENTINELX_BORINGSSL_BUILD_ROOT:-/srv/scratch/toolchains/boringssl-build}
STORE_ROOT=""
GARAGE_STORE=""
case "${BORING_BSSL_STORE_BACKEND:-local}" in
    local) ;;
    garage)
        # Native packages live in Garage; these are transaction files only.
        STORE_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/boringssl-garage-XXXXXXXX")"
        CACHE_ROOT="$STORE_ROOT/package"
        BUILD_ROOT="$STORE_ROOT/build"
        GARAGE_STORE="$(dirname "$(realpath -e "$0")")/native-garage-store"
        [[ -x "$GARAGE_STORE" ]] || {
            echo "boringssl-prebuilt: Garage S3 transport unavailable" >&2
            exit 2
        }
        trap 'rm -rf -- "$STORE_ROOT"' EXIT
        ;;
    *)
        echo "boringssl-prebuilt: unknown native package storage backend" >&2
        exit 2
        ;;
esac
CARGO_WRAPPER=${SENTINELX_CARGO_WRAPPER_PATH:-/usr/local/libexec/sentinelx-bin/cargo}
RUST_TOOLCHAIN=${SENTINELX_RUST_TOOLCHAIN:-1.99.1}
mkdir -p "$CACHE_ROOT"

lock_entry="$(
    awk -v wanted="$NATIVE_CRATE" -v wanted_version="${BORING_BSSL_PACKAGE_VERSION:-}" '
        function unquote(s) {
            sub(/^"/, "", s)
            sub(/"$/, "", s)
            return s
        }
        function finish_package() {
            if (name == wanted && (wanted_version == "" || version == wanted_version) && source == "registry+https://github.com/rust-lang/crates.io-index") {
                count++
                found_version = version
                found_checksum = checksum
            }
        }
        /^\[\[package\]\]$/ {
            if (in_package) finish_package()
            in_package = 1
            name = version = checksum = source = ""
            next
        }
        in_package && $1 == "name" && $2 == "=" { name = unquote($3) }
        in_package && $1 == "version" && $2 == "=" { version = unquote($3) }
        in_package && $1 == "source" && $2 == "=" { source = unquote($3) }
        in_package && $1 == "checksum" && $2 == "=" { checksum = unquote($3) }
        END {
            if (in_package) finish_package()
            if (count != 1 || found_version == "" || found_checksum == "") exit 2
            print found_version, found_checksum
        }
    ' "$PROJECT/Cargo.lock"
)" || {
    echo "boringssl-prebuilt: expected exactly one matching crates.io $NATIVE_CRATE package in $PROJECT/Cargo.lock" >&2
    exit 2
}
read -r VERSION CHECKSUM <<<"$lock_entry"

TARGET=${BORING_BSSL_TARGET:-x86_64-unknown-linux-gnu}
TARGET_US=${TARGET//-/_}
CC_TARGET_VAR=CC_$TARGET_US
CXX_TARGET_VAR=CXX_$TARGET_US
CC_BIN=${!CC_TARGET_VAR:-${HOST_CC:-${CC:-/usr/bin/cc}}}
CXX_BIN=${!CXX_TARGET_VAR:-${HOST_CXX:-${CXX:-/usr/bin/c++}}}
CC_PATH="$(command -v "$CC_BIN")"
CXX_PATH="$(command -v "$CXX_BIN")"

# These exact site wrappers only route the real compiler through the managed
# sccache client. CMake uses an explicit sccache launcher below, so normalize
# their identity to avoid needless duplicate native packages.
case "$CC_PATH" in
    /usr/local/libexec/sccache-strict-wrappers/cc) CC_PATH=/usr/bin/cc ;;
esac
case "$CXX_PATH" in
    /usr/local/libexec/sccache-strict-wrappers/c++) CXX_PATH=/usr/bin/c++ ;;
esac
AS_PATH="$(command -v "${AS:-as}")"
AR_PATH="$(command -v "${AR:-ar}")"
CMAKE_PATH="$(command -v "${CMAKE:-cmake}")"

tool_id() {
    local p
    p="$(readlink -f "$1")"
    # Native compiler binaries can be overwritten in place without an mtime
    # update. Hash contents, not inode/mtime, to keep the prebuilt ABI key real.
    printf '%s@%s' "$p" "$(sha256sum "$p" | cut -d ' ' -f 1)"
}

env_value() {
    printenv "$1" 2>/dev/null || true
}

CC_ID="$(tool_id "$CC_PATH")"
CXX_ID="$(tool_id "$CXX_PATH")"
AS_ID="$(tool_id "$AS_PATH")"
AR_ID="$(tool_id "$AR_PATH")"
CMAKE_ID="$(tool_id "$CMAKE_PATH")"

key_material="$(
    printf '%s\n' \
        "package-format=3" \
        "native-crate=$NATIVE_CRATE" \
        "$NATIVE_CRATE-version=$VERSION" \
        "$NATIVE_CRATE-checksum=$CHECKSUM" \
        "features=$FEATURE_KEY" \
        "target=$TARGET" \
        "profile=release" \
        "cc=$CC_ID" \
        "cxx=$CXX_ID" \
        "as=$AS_ID" \
        "ar=$AR_ID" \
        "cmake=$CMAKE_ID" \
        "cflags=${CFLAGS:-}" \
        "cflags-target=$(env_value "CFLAGS_$TARGET")" \
        "cflags-target-us=$(env_value "CFLAGS_$TARGET_US")" \
        "cxxflags=${CXXFLAGS:-}" \
        "cxxflags-target=$(env_value "CXXFLAGS_$TARGET")" \
        "cxxflags-target-us=$(env_value "CXXFLAGS_$TARGET_US")" \
        "rustflags=${RUSTFLAGS:-}" \
        "rustflags-target=$(env_value "CARGO_TARGET_${TARGET_US^^}_RUSTFLAGS")" \
        "cmake-toolchain=${CMAKE_TOOLCHAIN_FILE:-}" \
        "boring-sysroot=${BORING_BSSL_SYSROOT:-}" \
        "boring-external-toolchain=${BORING_BSSL_COMPILER_EXTERNAL_TOOLCHAIN:-}" \
        "release-opt=${CARGO_PROFILE_RELEASE_OPT_LEVEL:-3}" \
        "release-debug=${CARGO_PROFILE_RELEASE_DEBUG:-false}"
)"
key="$(printf '%s' "$key_material" | sha256sum | cut -c1-20)"
dest="$CACHE_ROOT/$NATIVE_CRATE-$VERSION-$FEATURE_KEY-$TARGET-$key"
lock="$CACHE_ROOT/.$NATIVE_CRATE-$key.lock"
if [[ -n "$GARAGE_STORE" ]]; then
    # The package staging root is unique per provider process. Coordinate
    # same-host cold misses using a runtime-only flock file instead of a
    # second persistent compiler/artifact cache.
    lock_parent="/run/user/$(id -u)"
    [[ -d "$lock_parent" && -w "$lock_parent" ]] || {
        echo "boringssl-prebuilt: writable per-user runtime directory required for Garage locks" >&2
        exit 2
    }
    mkdir -p "$lock_parent/boringssl-native-locks"
    lock="$lock_parent/boringssl-native-locks/$key.lock"
fi

complete() {
    [[ -d "$dest" && ! -L "$dest" ]] &&
        [[ -f "$dest/lib/libcrypto.a" ]] &&
        [[ -f "$dest/lib/libssl.a" ]] &&
        [[ -f "$dest/include/openssl/x509v3.h" ]] &&
        [[ -f "$dest/MANIFEST.txt" ]] &&
        [[ -f "$dest/SHA256SUMS" ]] &&
        rg -q '  include/openssl/x509v3.h$' "$dest/SHA256SUMS" &&
        rg -q '^cache-key='"$key"'$' "$dest/MANIFEST.txt" &&
        [[ -z "$(find "$dest/lib" "$dest/include" -type l -print -quit)" ]] &&
        (cd "$dest" && sha256sum -c --status SHA256SUMS)
}

# Expose native archives under the actual canonical Cargo target root.
# Never create a symlink to a package outside its sandbox.
publish_path() {
    if [[ -z "${BORING_BSSL_VIEW_ROOT:-}" ]]; then
        printf '%s\n' "$dest"
        return 0
    fi

    local root view_root view_dir stage_view
    root="$BORING_BSSL_VIEW_ROOT"
    [[ "$root" == /* ]] || {
        echo "boringssl-prebuilt: BORING_BSSL_VIEW_ROOT must be absolute" >&2
        return 2
    }
    if [[ -z "${SCCACHE_CANONICAL_TARGET_ROOT:-}" ]] ||
       [[ "$(realpath -m "$root")" != "$(realpath -m "$SCCACHE_CANONICAL_TARGET_ROOT")" ]]; then
        echo "boringssl-prebuilt: canonical target root must be set and match the view root" >&2
        return 2
    fi

    view_root="$root/boringssl-prebuilt"
    mkdir -p "$view_root"
    view_dir="$view_root/$(basename "$dest")"
    exec 8>"$view_root/.$key.lock"
    flock -x 8
    if [[ -e "$view_dir" || -L "$view_dir" ]]; then
        if [[ ! -d "$view_dir" || -L "$view_dir" || ! -f "$view_dir/SHA256SUMS" ]] ||
           [[ -n "$(find "$view_dir" -type l -print -quit)" ]] ||
           ! cmp -s "$dest/SHA256SUMS" "$view_dir/SHA256SUMS" ||
           ! (cd "$view_dir" && sha256sum -c --status SHA256SUMS); then
            echo "boringssl-prebuilt: corrupt or incomplete view: $view_dir" >&2
            return 1
        fi
        printf '%s\n' "$view_dir"
        return 0
    fi

    stage_view="$(mktemp -d "$view_root/.stage-$key-XXXXXX")"
    if ! cp -a --reflink=auto "$dest/." "$stage_view/" ||
       [[ -n "$(find "$stage_view" -type l -print -quit)" ]] ||
       ! cmp -s "$dest/SHA256SUMS" "$stage_view/SHA256SUMS" ||
       ! (cd "$stage_view" && sha256sum -c --status SHA256SUMS); then
        rm -rf -- "$stage_view"
        echo "boringssl-prebuilt: failed to materialize canonical view" >&2
        return 1
    fi
    mv -T "$stage_view" "$view_dir"
    printf '%s\n' "$view_dir"
}

if complete; then
    publish_path
    exit 0
fi

exec 9>"$lock"
flock -x 9
if complete; then
    publish_path
    exit 0
fi
if [[ -e "$dest" || -L "$dest" ]]; then
    echo "boringssl-prebuilt: existing native package failed integrity check: $dest" >&2
    exit 1
fi

# S3 GET is tried before native compilation. 404 is the only permitted cache
# miss; transport faults or corrupt artifacts cannot be treated as misses.
if [[ -n "$GARAGE_STORE" ]]; then
    remote_stage="$(mktemp -d "$CACHE_ROOT/.remote-$key-XXXXXX")"
    get_rc=0
    "$GARAGE_STORE" get "$key" "$remote_stage" || get_rc=$?
    case "$get_rc" in
        0)
            original_dest="$dest"
            dest="$remote_stage"
            if ! complete; then
                echo "boringssl-prebuilt: Garage object failed package integrity verification" >&2
                exit 1
            fi
            dest="$original_dest"
            mv -T "$remote_stage" "$dest"
            publish_path
            exit 0
            ;;
        3)
            rm -rf -- "$remote_stage"
            ;;
        *)
            echo "boringssl-prebuilt: Garage S3 GET failed (status $get_rc)" >&2
            exit 1
            ;;
    esac
fi

stage="$(mktemp -d "$CACHE_ROOT/.stage-$key-XXXXXX")"
work=""
cleanup() {
    rc=$?
    [[ -z "$work" ]] || rm -rf -- "$work"
    rm -rf -- "$stage"
    [[ -z "$STORE_ROOT" ]] || rm -rf -- "$STORE_ROOT"
    exit "$rc"
}
trap cleanup EXIT INT TERM HUP

mkdir -p "$stage/lib"

feature_enabled() {
    local want=$1 item
    IFS=',' read -r -a feature_items <<<"$FEATURE_KEY"
    for item in "${feature_items[@]}"; do
        [[ "$item" == "$want" ]] && return 0
    done
    return 1
}

if [[ -n "$SEED_OUT" ]]; then
    [[ -f "$SEED_OUT/build/libcrypto.a" && -f "$SEED_OUT/build/libssl.a" ]] || {
        echo "boringssl-prebuilt: seed OUT_DIR is incomplete: $SEED_OUT" >&2
        exit 3
    }
    [[ -f "$SEED_OUT/boringssl/include/openssl/x509v3.h" ]] || {
        echo "boringssl-prebuilt: seed OUT_DIR lacks patched headers: $SEED_OUT" >&2
        exit 3
    }
    cp -a "$SEED_OUT/build/libcrypto.a" "$stage/lib/"
    cp -a "$SEED_OUT/build/libssl.a" "$stage/lib/"
    if feature_enabled fips; then
        [[ -f "$SEED_OUT/build/bcm.o" ]] || {
            echo "boringssl-prebuilt: FIPS seed is missing bcm.o" >&2
            exit 3
        }
        cp -a "$SEED_OUT/build/bcm.o" "$stage/lib/"
    fi
    cp -a "$SEED_OUT/boringssl/include" "$stage/"
else
    mkdir -p "$BUILD_ROOT"
    work="$(mktemp -d "$BUILD_ROOT/bssl-prebuilt-$key-XXXXXX")"
    mkdir -p "$work/project/src" "$work/install"

    features_toml=""
    if [[ "$FEATURE_KEY" != default ]]; then
        IFS=',' read -r -a feature_items <<<"$FEATURE_KEY"
        feature_list=""
        for item in "${feature_items[@]}"; do
            [[ -n "$item" ]] || continue
            [[ -z "$feature_list" ]] || feature_list+=", "
            feature_list+="\"$item\""
        done
        features_toml=", default-features = false, features = [$feature_list]"
    fi

    cat >"$work/project/Cargo.toml" <<EOF
[package]
name = "sentinelx-boringssl-prebuild"
version = "0.0.0"
edition = "2024"

[dependencies]
$NATIVE_CRATE = { version = "=$VERSION"$features_toml }
EOF
    printf '%s\n' '#![allow(dead_code)]' >"$work/project/src/lib.rs"

    export CC="$CC_PATH"
    export CXX="$CXX_PATH"
    export CMAKE_C_COMPILER_LAUNCHER=${CMAKE_C_COMPILER_LAUNCHER:-/usr/local/libexec/sccache-client}
    export CMAKE_CXX_COMPILER_LAUNCHER=${CMAKE_CXX_COMPILER_LAUNCHER:-/usr/local/libexec/sccache-client}

    # This cache is keyed to the crate's bundled/patched BoringSSL source. Do
    # not let a caller's prebuilt/source override leak into first generation.
    unset BORING_BSSL_PATH BORING_BSSL_INCLUDE_PATH BORING_BSSL_SOURCE_PATH BORING_BSSL_ASSUME_PATCHED
    unset BORING_BSSL_FIPS_PATH BORING_BSSL_FIPS_INCLUDE_PATH BORING_BSSL_FIPS_SOURCE_PATH BORING_BSSL_FIPS_ASSUME_PATCHED

    if feature_enabled fips; then
        export BORING_BSSL_FIPS_INSTALL_DIR="$work/install"
        unset BORING_BSSL_INSTALL_DIR
    else
        export BORING_BSSL_INSTALL_DIR="$work/install"
        unset BORING_BSSL_FIPS_INSTALL_DIR
    fi

    (
        cd "$work/project"
        # The provider may be called inside a consumer Cargo build. Never
        # reuse the caller's persistent target artifacts or its canonical
        # Rust source root for this nested, independently keyed native build.
        export CARGO_TARGET_DIR="$work/target"
        export SCCACHE_CANONICAL_TARGET_ROOT="$CARGO_TARGET_DIR"
        unset SCCACHE_CANONICAL_TARGET_ROOT_ORIGIN
        # Use the site wrapper so cache generation gets the managed registry
        # source pool, package-cache policy, native sccache launcher and target
        # reclamation. A new crate version may fetch its archive once.
        "$CARGO_WRAPPER" +"$RUST_TOOLCHAIN" build --release --target "$TARGET"
    )
    cp -a "$work/install"/. "$stage"/
fi

cat >"$stage/MANIFEST.txt" <<EOF
$key_material
cache-key=$key
created-utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
seed-out=$SEED_OUT
EOF
(
    cd "$stage"
    # Patched headers affect bindgen ABI. Validate them and the key manifest
    # alongside the native archives, not merely the two static libraries.
    find lib include -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum >SHA256SUMS
    sha256sum MANIFEST.txt >>SHA256SUMS
    sha256sum -c --status SHA256SUMS
)
mv -T "$stage" "$dest"
stage=""
# Upload only after full native headers+libraries verification. Garage PUT
# publishes the archive atomically under its content-derived identity.
if [[ -n "$GARAGE_STORE" ]]; then
    "$GARAGE_STORE" put "$key" "$dest"
fi
[[ -z "$work" ]] || rm -rf -- "$work"
work=""
trap - INT TERM HUP
if [[ -n "$STORE_ROOT" ]]; then
    trap 'rm -rf -- "$STORE_ROOT"' EXIT
else
    trap - EXIT
fi
publish_path
