#!/usr/bin/env bash
set -euo pipefail
fixture="$(dirname "$0")"
printf '%s' "${RUSTUP_TOOLCHAIN:-}" >"$fixture/toolchain"
case "$1" in
    locate-project)
        printf '%s\0' "$@" >"$fixture/locate-args"
        if [[ -f "$fixture/locate-workspace" ]]; then
            workspace="$(cat "$fixture/locate-workspace")"
        else
            workspace="$PWD"
        fi
        printf '%s\n' "$workspace/Cargo.toml"
        ;;
    clean)
        rm -rf -- "${CARGO_TARGET_DIR:-$PWD/target}"
        ;;
    metadata|build)
        printf 'offline=%s shared=%s' "${CARGO_NET_OFFLINE:-}" "${CARGO_SHARED_LOCKED_OFFLINE_RESOLUTION:-}" >"$fixture/offline"
        [[ "$1" == build ]] || exit 0
        src="$EPHEMERAL_CARGO_REGISTRY_SRC/index.crates.io-test/fake-1.0"
        if [[ -f "$src/srcfile" ]]; then
            printf 'warm' >"$fixture/warm"
        fi
        mkdir -p "$src" "$CARGO_TARGET_DIR/debug/deps"
        printf 'registry source' >"$src/srcfile"
        printf '%s' "${CMAKE_C_COMPILER_LAUNCHER:-}" >"$fixture/cmake-c"
        printf '%s' "${CMAKE_CXX_COMPILER_LAUNCHER:-}" >"$fixture/cmake-cxx"
        if [[ -f "$fixture/fail-build" ]]; then
            printf 'failed-intermediate' >"$CARGO_TARGET_DIR/debug/deps/failed-intermediate"
            exit 23
        fi
        printf '#!/bin/sh\necho final\n' >"$CARGO_TARGET_DIR/debug/fake-bin"
        chmod +x "$CARGO_TARGET_DIR/debug/fake-bin"
        printf 'library' >"$CARGO_TARGET_DIR/debug/libfake.rlib"
        printf 'intermediate' >"$CARGO_TARGET_DIR/debug/deps/intermediate"
        printf 'depinfo' >"$CARGO_TARGET_DIR/debug/fake-bin.d"
        ;;
    *) exit 64 ;;
esac
