#!/usr/bin/env bash
set -uo pipefail

CONF="${SENTINELX_BUILD_SCRATCH_CONF:-/etc/sentinelx/build-scratch.conf}"
[[ -r "$CONF" ]] && . "$CONF"

REAL_CARGO="${SENTINELX_REAL_CARGO:-/usr/local/libexec/cargo-rustup-real}"
TARGET_ROOT="${SENTINELX_CARGO_TARGET_ROOT:-/var/cache/sentinelx/cargo-target}"
TARGET_LOCK_ROOT="${SENTINELX_CARGO_TARGET_LOCK_ROOT:-$TARGET_ROOT/../cargo-target-locks}"
PRUNER="${SENTINELX_CARGO_TARGET_PRUNER:-/usr/local/libexec/sentinelx-bin/cargo-target-prune}"
SOURCE_PRUNER="${SENTINELX_CARGO_SOURCE_PRUNER:-/usr/local/libexec/sentinelx-bin/cargo-source-prune}"
OFFLINE_READY_HELPER="${SENTINELX_CARGO_OFFLINE_READY_HELPER:-/usr/local/libexec/sentinelx-bin/cargo-offline-ready}"
SOURCE_TMP_ROOT="${SENTINELX_CARGO_SOURCE_TMP_ROOT:-/var/cache/sentinelx/cargo-source-tmp}"
INFRA_LOCK="${SENTINELX_CARGO_INFRA_LOCK:-/var/cache/sentinelx/.cargo-infra.lock}"
MAINTENANCE_MARKER="${SENTINELX_CARGO_MAINTENANCE_MARKER:-/var/cache/sentinelx/.cargo-maintenance}"

cargo_args=("$@")
toolchain=""
case "$0" in
    */toolchains/*/bin/cargo)
        if [[ -z "${RUSTUP_TOOLCHAIN:-}" ]]; then
            toolchain_parent="${0%/bin/cargo}"
            export RUSTUP_TOOLCHAIN="${toolchain_parent##*/}"
        fi
        ;;
esac

if (( ${#cargo_args[@]} )) && [[ "${cargo_args[0]}" == +* ]]; then
    toolchain="${cargo_args[0]#+}"
    cargo_args=("${cargo_args[@]:1}")
    export RUSTUP_TOOLCHAIN="$toolchain"
fi

export EPHEMERAL_CARGO_WRAPPER="${SENTINELX_CARGO_WRAPPER_PATH:-/usr/local/libexec/sentinelx-bin/cargo}"
export CARGO="$EPHEMERAL_CARGO_WRAPPER"

nested_wrapper=0
if [[ -n "${EPHEMERAL_CARGO_REGISTRY_SRC:-}" || "${EPHEMERAL_CARGO_WRAPPER_ACTIVE:-0}" == 1 ]]; then
    nested_wrapper=1
fi
export EPHEMERAL_CARGO_WRAPPER_ACTIVE=1

maintenance_active() {
    [[ -f "$MAINTENANCE_MARKER" ]] || return 1
    local pid=""
    read -r pid <"$MAINTENANCE_MARKER" 2>/dev/null || true
    if [[ "$pid" =~ ^[0-9]+$ && -d "/proc/$pid" ]]; then
        return 0
    fi
    rm -f "$MAINTENANCE_MARKER" 2>/dev/null || return 0
    return 1
}

mkdir -p "$(dirname "$INFRA_LOCK")"
exec 7>"$INFRA_LOCK"
if (( nested_wrapper )); then
    flock -s 7
else
    while :; do
        while maintenance_active; do
            sleep 0.2
        done
        flock -s 7
        if ! maintenance_active; then
            break
        fi
        flock -u 7
    done
fi

source_slot="$SOURCE_TMP_ROOT/uid-$(id -u)"
source_tmp="$source_slot/src"
source_last_used="$source_slot/.last-used"
source_prune_checked="$source_slot/.prune-checked"
mkdir -p "$source_slot"
exec 8>"$source_slot/.active.lock"

spawn_detached() {
    local cmd="$1"
    [[ -x "$cmd" ]] || return 0

    # Detached maintenance must never inherit wrapper lifetime locks. setsid -f
    # forks and returns immediately, so expensive tree walks stay off Cargo's
    # latency-sensitive path.
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$cmd" 7>&- 8>&- 9>&- </dev/null >/dev/null 2>&1 || true
    else
        (
            exec 7>&- 8>&- 9>&-
            "$cmd" </dev/null >/dev/null 2>&1
        ) &
    fi
}

schedule_target_prune() {
    spawn_detached "$PRUNER"
}

schedule_source_prune() {
    spawn_detached "$SOURCE_PRUNER"
}

flock -s 8
mkdir -p "$source_tmp"
export EPHEMERAL_CARGO_REGISTRY_SRC="$source_tmp"

finish_source_pool() {
    touch "$source_last_used" 2>/dev/null || true
    flock -u 8 2>/dev/null || true
    schedule_source_prune
}

compile=0
resolver_managed=0
for arg in "${cargo_args[@]}"; do
    case "$arg" in
        build|check|test|run|bench|rustc|rustdoc|doc|clippy|fix|install|package|publish)
            compile=1
            resolver_managed=1
            break
            ;;
        metadata)
            # Metadata is read-only with --locked, and can otherwise reproduce
            # the same package-cache resolver serialization as a build. Let it
            # use the conservative offline/shared gate without putting it on
            # the managed target/artifact path.
            resolver_managed=1
            ;;
    esac
done

if (( ! resolver_managed )); then
    "$REAL_CARGO" "${cargo_args[@]}"
    rc=$?
    finish_source_pool
    exit "$rc"
fi

locate=("$REAL_CARGO" locate-project --workspace --message-format plain)
manifest="$("${locate[@]}" 2>/dev/null || true)"

if [[ -n "$manifest" ]]; then
    workspace="$(dirname "$(readlink -f "$manifest")")"
else
    workspace="$(pwd -P)"
fi

maybe_enable_shared_offline() {
    [[ "${SENTINELX_CARGO_SHARED_OFFLINE_AUTO:-1}" != 0 ]] || return 0

    local locked=0 offline=0 arg
    for arg in "${cargo_args[@]}"; do
        case "$arg" in
            --locked)
                locked=1
                ;;
            --offline)
                offline=1
                ;;
            --frozen)
                locked=1
                offline=1
                ;;
        esac
    done
    (( locked )) || return 0

    # Explicit offline/frozen intent is always eligible. The Cargo fork still
    # performs its own safety checks (existing resolve, no git sources, etc.).
    if (( offline )) || [[ "${CARGO_NET_OFFLINE:-}" == true || "${CARGO_NET_OFFLINE:-}" == 1 ]]; then
        export CARGO_SHARED_LOCKED_OFFLINE_RESOLUTION="${CARGO_SHARED_LOCKED_OFFLINE_RESOLUTION:-1}"
        return 0
    fi

    # Respect an explicit online choice. Otherwise, only auto-offline a locked
    # build when the lockfile checker proves every crates.io index entry and
    # archive is already local. First-time/incomplete-cache builds stay online.
    [[ -z "${CARGO_NET_OFFLINE+x}" ]] || return 0
    [[ -x "$OFFLINE_READY_HELPER" ]] || return 0
    if "$OFFLINE_READY_HELPER" "$workspace" "${CARGO_HOME:-$HOME/.cargo}"; then
        export CARGO_NET_OFFLINE=true
        export CARGO_SHARED_LOCKED_OFFLINE_RESOLUTION="${CARGO_SHARED_LOCKED_OFFLINE_RESOLUTION:-1}"
    fi
}

maybe_enable_shared_offline

if (( ! compile )); then
    "$REAL_CARGO" "${cargo_args[@]}"
    rc=$?
    finish_source_pool
    exit "$rc"
fi

# Rust uses RUSTC_WRAPPER=sccache, but CMake-based build scripts otherwise
# invoke cc/c++ directly and bypass the shared compiler cache. CMake 3.17+
# initializes these variables from the environment on first configure. Keep
# an explicit project/user launcher intact, and allow the site default to be
# disabled by setting SENTINELX_CMAKE_COMPILER_LAUNCHER to an empty value.
cmake_launcher="${SENTINELX_CMAKE_COMPILER_LAUNCHER-/usr/local/libexec/sccache-client}"
if [[ -n "$cmake_launcher" && -x "$cmake_launcher" ]]; then
    export CMAKE_C_COMPILER_LAUNCHER="${CMAKE_C_COMPILER_LAUNCHER:-$cmake_launcher}"
    export CMAKE_CXX_COMPILER_LAUNCHER="${CMAKE_CXX_COMPILER_LAUNCHER:-$cmake_launcher}"
fi

mkdir -p "$TARGET_ROOT" "$TARGET_LOCK_ROOT"

hash="$(printf '%s' "$workspace" | sha256sum | cut -c1-16)"
name="$(basename "$workspace" | tr -c 'A-Za-z0-9._-' '_')"
target="$TARGET_ROOT/${name}-${hash}"
target_lock="$TARGET_LOCK_ROOT/${name}-${hash}.lock"
mkdir -p "$target"
touch "$target/.last-used"

# The lock lives outside the disposable target tree. This avoids the inode
# recreation race that is possible when a pruner removes a lock file together
# with the directory it protects.
exec 9>"$target_lock"
flock -s 9

min_free="${SENTINELX_NVME_MIN_FREE_BYTES:-3221225472}"
avail="$(df -B1 --output=avail "$TARGET_ROOT" 2>/dev/null | tail -n1 | tr -d ' ')"
if [[ "$avail" =~ ^[0-9]+$ ]] && (( avail < min_free )); then
    # Low free space is the one case where synchronous maintenance is worth
    # blocking Cargo. The current workspace remains protected by its shared
    # lifetime lock while inactive targets are reclaimed.
    SENTINELX_CARGO_TARGET_PRUNE_FORCE=1 "$PRUNER" >/dev/null 2>&1 || true
    avail="$(df -B1 --output=avail "$TARGET_ROOT" 2>/dev/null | tail -n1 | tr -d ' ')"
fi
if [[ "$avail" =~ ^[0-9]+$ ]] && (( avail < min_free )); then
    echo "cargo: NVMe scratch has only $avail bytes free after emergency pruning; reserve is $min_free. Refusing to fill the root filesystem." >&2
    flock -u 9
    finish_source_pool
    exit 75
fi

build_tmp="$target/.tmp-$$"
mkdir -p "$build_tmp"
export TMPDIR="$build_tmp"
export TMP="$build_tmp"
export TEMP="$build_tmp"
export CARGO_TARGET_DIR="$target"

artifact_root="${SENTINELX_CARGO_ARTIFACT_ROOT:-$workspace/target}"

mirror_final_artifacts() {
    [[ "${SENTINELX_CARGO_ARTIFACT_MIRROR:-1}" == 1 ]] || return 0
    [[ "$artifact_root" != "$target" ]] || return 0

    local file rel base dest tmp
    while IFS= read -r -d '' file; do
        rel="${file#"$target"/}"
        case "/$rel/" in
            */.fingerprint/*|*/deps/*|*/build/*|*/incremental/*|*/doc/*|*/.tmp-*/*)
                continue
                ;;
        esac

        base="${file##*/}"
        case "$base" in
            *.d|*.rmeta|.cargo-lock|.rustc_info.json|.last-used|.sentinelx-build.lock)
                continue
                ;;
        esac

        if [[ ! -x "$file" && ! "$base" =~ \.(rlib|a|so|dylib|dll|lib|wasm|pdb)$ ]]; then
            continue
        fi

        dest="$artifact_root/$rel"
        mkdir -p "$(dirname "$dest")"
        tmp="$dest.sentinelx-tmp-$$"
        rm -f -- "$tmp"
        if ! cp -a --reflink=auto -- "$file" "$tmp" 2>/dev/null; then
            cp -a -- "$file" "$tmp"
        fi
        mv -f -- "$tmp" "$dest"
    done < <(
        find "$target" \
            \( -type d \( -name .fingerprint -o -name deps -o -name build -o -name incremental -o -name doc -o -name '.tmp-*' \) -prune \) -o \
            -type f -print0 2>/dev/null
    )
}

cleanup() {
    rc=$?
    trap - EXIT INT TERM HUP

    rm -rf -- "$build_tmp" 2>/dev/null || true
    touch "$target/.last-used" 2>/dev/null || true

    if (( rc == 0 )); then
        mirror_final_artifacts || rc=$?
    fi

    flock -u 9 2>/dev/null || true

    # Targets are scratch-only even when Cargo fails. sccache retains useful
    # compiler outputs, while leaving a failed multi-GiB target behind can pin
    # scarce NVMe space indefinitely. The last Cargo using this workspace
    # upgrades to the external exclusive lock and reclaims all intermediates.
    if [[ "${SENTINELX_CARGO_TARGET_EPHEMERAL:-1}" == 1 ]]; then
        if flock -n -x 9; then
            rm -rf -- "$target" 2>/dev/null || true
            flock -u 9 2>/dev/null || true
        fi
    fi

    schedule_target_prune
    finish_source_pool
    exit "$rc"
}
trap cleanup EXIT INT TERM HUP

"$REAL_CARGO" "${cargo_args[@]}"
